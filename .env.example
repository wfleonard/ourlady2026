# Postgres
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Site URL used to build Stripe success/cancel return URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Google Analytics — leave blank to disable (e.g. in dev)
NEXT_PUBLIC_GA_ID=

# Order alert emails to the store owner via the Google Workspace SMTP relay.
# The relay authenticates by server IP (allowlisted in Google Admin → Gmail →
# Routing → SMTP relay service), so SMTP_USER/SMTP_PASS stay blank.
# Leave SMTP_HOST blank to disable alerts.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ORDER_NOTIFY_TO=wfleonard@primosmaternos.com
MAIL_FROM=Primos Maternos Store <wfleonard@primosmaternos.com>

# Saxon Admin dashboard (saxonwebdev.com): each new order is recorded there.
# SAXON_ADMIN_SECRET must equal EVENT_SECRET_PRIMOS in the dashboard's .env.
# Leave SAXON_ADMIN_SECRET blank to turn this off.
SAXON_ADMIN_URL=https://saxonwebdev.com
SAXON_ADMIN_SITE=primos
SAXON_ADMIN_SECRET=
